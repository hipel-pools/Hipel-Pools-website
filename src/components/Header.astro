---
import NavItems from './NavItems.astro';
import { SITE, href } from '../lib/content';
const home = href('/', 'main');
---
<header class="site-header" data-header>
  <div class="site-header__inner page-center">
    <a class="site-header__logo" href={home} aria-label="Hipel Pools home">
      <img src={href(SITE.logo, 'main')} alt="Hipel Pools Swimming Pool Contractors Logo" width="500" height="214" />
    </a>
    <nav class="site-nav" aria-label="Main" data-nav>
      <NavItems items={SITE.nav} />
      <div class="site-nav__mobile-extra">
        <a href={SITE.phoneHref}>Call {SITE.phone}</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </nav>
    <div class="site-header__right">
      <a class="site-header__icon" href={SITE.phoneHref} aria-label={`Call ${SITE.phone}`} title={SITE.phone}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
      </a>
      <span class="site-header__sep" aria-hidden="true"></span>
      <a class="site-header__icon" href={`mailto:${SITE.email}`} aria-label={`Email ${SITE.email}`} title={SITE.email}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.2V17h16V7.2l-8 5.3-8-5.3zM5.5 7l6.5 4.3L18.5 7h-13z"/></svg>
      </a>
      <a class="hp-btn site-header__cta" href={href(SITE.quoteUrl, 'main')}>Request A Quote</a>
      <button class="site-header__burger" aria-label="Open menu" aria-expanded="false" data-burger>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
